.save V(V_BUS) V(BONE_P) V(V3V3) V(I_SET) V(I_SENSE) V(BONE_N) V(OUTA) I(R_BONE) I(VBUS) I(R1) I(R4) I(R10)
.options plotwinsize=0 numdgt=15
.end
