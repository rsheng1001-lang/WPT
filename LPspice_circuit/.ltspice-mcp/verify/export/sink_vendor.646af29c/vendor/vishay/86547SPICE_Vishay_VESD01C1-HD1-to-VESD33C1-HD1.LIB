.model DF D(IS=3.3e-16 N=1 RS=0.195 CJO=62p M=0.34 VJ=0.70 ISR=1e-16 NR=2
+BV=7.5 IBV=1m NBV=0.6 IBVL=300n NBVL=8)
D2 1 2 DVCF 
.model DVCF D(IS=1f N=1.2 RS=0.274) 
.ends VESD05C1
*******************************************************************************
