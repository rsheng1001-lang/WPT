* This library is valid for Vishay VESDxxC1-HD1 diodes:                 
*                                                               
*       VESD01C1
*	VESD03C1
*	VESD05C1
*	VESD08C1
*	VESD12C1
*	VESD16C1
*	VESD26C1
*	VESD33C1
*
*  86547SPICE_Vishay_VESD01C1-HD1-to-VESD33C1-HD1.LIB
*
*  TNOM=27GRD, RS without heating
*                                                               
*  Vishay Semiconductor GmbH
*  Claus Mähner, February 2022
*
*  Copyright:                            
*  Vishay Intertechnology, Inc.          
*                                                             
*******************************************************************************
.subckt VESD01C1 1 2
D2 2 6 DBLOCK  
.model DBLOCK D(IS=1f RS=1n)  
D3 7 6 DOFFSET  
.model DOFFSET D(IS=1f RS=1n BV=0.87 NBV=0.5)  
D4 7 1 DHIGH  
.model DHIGH D(IS=350u N=12 RS=1)  
D5 2 1 DLOW 
.model DLOW D(IS=500p N=4 RS=1000 IKF=4u)  
D6 1 2 DF  
.model DF D(IS=7e-16 N=1 RS=0.107 CJO=175p M=0.25 VJ=0.48 ISR=2e-10 NR=2)
D7 2 3 DVC  
.model DVC D(IS=1n N=0.5 RS=0.132)
VC0 3 1 4.8
.ends VESD01C1
*******************************************************************************
.subckt VESD03C1 1 2
D2 2 6 DBLOCK  
.model DBLOCK D(IS=1f RS=1n)  
D3 7 6 DOFFSET  
.model DOFFSET D(IS=1f RS=1n BV=3.3 NBV=0.5)  
D4 7 1 DHIGH  
.model DHIGH D(IS=350n N=2 ISR=1m NR=20 RS=0.146)  
D5 2 1 DLOW 
.model DLOW D(IS=4p N=6.5 RS=100 IKF=4.2u)  
D6 1 2 DF  
.model DF D(IS=5e-16 N=1 RS=0.107 CJO=122p M=0.35 VJ=0.73 ISR=2e-13 NR=1.5)
.ends VESD03C1
*******************************************************************************
.subckt VESD05C1 1 2
