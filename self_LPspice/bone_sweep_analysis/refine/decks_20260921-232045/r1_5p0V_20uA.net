* Library below included based on ModelFile attribute of instance X§U1 (C:\Users\Liuxm\AppData\Local\LTspice\lib\sym\OpAmps\UniversalOpAmp2.asy)
.lib UniversalOpAmp2.lib
.backanno
.param IREF=20.0u
.param VBP=5
.param R5SET=10k*(3.3/(IREF*3k)-1)
.step param RB list 250k 251k 252k 253k 254k 255k 256k 257k 258k 259k 260k
.end
