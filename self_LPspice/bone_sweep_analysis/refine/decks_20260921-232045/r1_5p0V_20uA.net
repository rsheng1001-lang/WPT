* refine deck  VBP=5 V  IREF=20uA  RB 250k..260k (11 pts, step 1k)
* Generated by LTspice 26.0.2 for Windows.
V1 BUS 0 12
R1 P001 BONE_P 560k
R2 FB P001 6.8k
R3 FB 0 100k
C1 BUS 0 1e-7
C2 BONE_P 0 4.7e-7
V2 BONE_P 0 {VBP}
V3 3V3 0 3.3
R5 N001 3V3 {R5SET}
R6 N001 I_SET 10k
R7 N001 0 10k
C3 I_SET 0 1e-7
C14 I_SENSE OUTA 100pF
R8 STIM_GATE OUTA 10k
X§U2 BONE_N STIM_GATE I_SENSE T2N7002AK_G0_00 ;§pnba 3)1)2
R9 STIM_GATE I_SENSE 10Meg
R10 I_SENSE 0 3k
R_BONE BONE_N BONE_P {RB}
X§U1 I_SET I_SENSE 3V3 0 OUTA level2 Avol=3.16Meg GBW=350k Slew=160k Ilimit=5m Rail=50m Vos=2u En=55n Enk=0 In=100f Ink=0 Rin=1T ;§pnba In+)In-)V+)V-)OUT
.meas tran IBONE AVG -I(R_BONE) FROM 12m TO 15m
.meas tran VBONE AVG V(BONE_P,BONE_N) FROM 12m TO 15m
.meas tran IERR PARAM 100*abs(IBONE-IREF)/IREF
.meas tran PASS PARAM if(IERR<=1,1,0)
.tran 15m startup
